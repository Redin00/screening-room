# Copy this file to .env and adjust values before running in production.

# Port the HTTP + WebSocket server listens on
PORT=3000

# Secret used to sign session cookies. Change this to a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Minutes to wait after a room is closed (or after a file is replaced)
# before its uploaded video is deleted from disk.
DELETE_DELAY_MINUTES=10

# How often (minutes) the background sweep checks for files/rooms that
# are overdue for cleanup. Acts as a safety net if the server restarted
# and lost an in-memory deletion timer.
CLEANUP_SWEEP_MINUTES=2

# If a room's host disconnects and no host reconnects within this many
# minutes, the room is auto-closed and its file scheduled for deletion.
ORPHAN_ROOM_MINUTES=15

# Max upload size in megabytes.
MAX_UPLOAD_MB=4096

# PIN assigned to the auto-created bootstrap admin profile on first run.
# If left blank, a random PIN is generated and printed to the console once.
ADMIN_BOOTSTRAP_PIN=
